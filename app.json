{
  "expo": {
    "name": "Libri",
    "slug": "Libri",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/LogoSplash.png",
    "scheme": "fichedelecture",
    "userInterfaceStyle": "automatic",
    "ios": {
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#208AEF"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./src/assets/images/LogoSplash.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF6EE",
          "image": "./src/assets/images/LogoSplash.png",
          "imageWidth": 76
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Libri a besoin d'accéder à votre caméra pour changer votre photo de profil.",
          "photosPermission": "Libri a besoin d'accéder à vos photos pour changer votre photo de profil.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
