{
  "expo": {
    "name": "Libri",
    "slug": "Libri",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/LogoSplash.png",
    "scheme": "fichedelecture",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": ""
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./src/assets/images/LogoSplash.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./src/assets/images/LogoSplash.png",
          "imageWidth": 76
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
