{
  "expo": {
    "name": "Libri",
    "slug": "Libri",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/LogoSplash.png",
    "scheme": "fichedelecture",
    "userInterfaceStyle": "automatic",
    "ios": {},
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#208AEF"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.anonymous.Libri"
    },
    "web": {
      "output": "single",
      "favicon": "./src/assets/images/LogoSplash.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF6EE",
          "image": "./src/assets/images/LogoSplash.png",
          "imageWidth": 200
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Libri a besoin d'accéder à tes photos pour choisir ta photo de profil.",
          "cameraPermission": "Libri a besoin d'accéder à ta caméra pour prendre ta photo de profil."
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
